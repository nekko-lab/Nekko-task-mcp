# Discord Developer Portal → Bot → Reset Token で発行したトークン
DISCORD_BOT_TOKEN=
# 読み取りを許可するサーバーID（ネットワークコンテンツ研究会のサーバーID）
ALLOWED_GUILD_IDS=
# URLに入れる秘密文字列: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_SECRET=
# 自分のDiscordユーザーID（自分宛てメンションの抽出に使う）
OWNER_USER_ID=
# 読ませたくないチャンネルID（任意・カンマ区切り）
EXCLUDED_CHANNEL_IDS=

# ---- Growi（研究会wiki）。両方入れると Growi ツールが有効になる
# GROWI_URL=https://growi.maruru.me
# GROWI_API_TOKEN=          # 専用の bot ユーザーで発行したトークン推奨
# GROWI_WRITE_PREFIXES=/    # 書き込みを許すパスの接頭辞（カンマ区切り）
# GROWI_MEMBER_WRITE=false  # true にするとメンバー用URLでも書き込み可（非推奨）

# ---- v6
# DIGEST_TIME=09:00              # 毎朝の自動まとめ（DIGEST_AUTO=false で無効）
# EVENT_NAME=津田沼祭 / EVENT_DATE=2026-11-21
# GCAL_SERVICE_ACCOUNT_FILE=/path/to/secrets/gcal.json
# GCAL_TASK_CALENDAR_ID=xxxx@group.calendar.google.com
# GCAL_EVENT_CALENDAR_ID=
# DISCORD_APP_ID=
# DISCORD_PUBLIC_KEY=
# DIGEST_CALENDAR_URL=https://calendar.google.com/calendar/u/0?cid=...
